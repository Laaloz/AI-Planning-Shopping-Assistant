# Copy to .env for local development. Never commit real values.

# Supabase project URL and publishable key.
# Local stack: run `supabase status`. Remote dev project: Dashboard -> Project Settings -> API Keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Browser origins allowed to call the API directly, comma-separated.
# The frontend normally calls the backend through its same-origin /api rewrite.
ALLOWED_ORIGINS=http://localhost:3000

# Port for the local development server.
PORT=8787
