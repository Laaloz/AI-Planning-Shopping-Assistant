{
  "name": "ai-planning-shopping-assistant",
  "version": "0.0.0",
  "private": true,
  "description": "AI planning and shopping assistant: a live, structured plan that users build and change through conversation.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "pnpm build:packages && pnpm --recursive lint",
    "typecheck": "pnpm build:packages && pnpm --recursive typecheck",
    "test": "pnpm build:packages && pnpm --recursive test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
